<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\Application\Application.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Azure.Identity" />
      <!-- Cloud secrets manager SDK packages - all included in source for compilation -->
      <PackageReference Include="Azure.Security.KeyVault.Secrets" />
      <PackageReference Include="AWSSDK.SecretsManager" />
      <PackageReference Include="Google.Cloud.SecretManager.V1" />
      <PackageReference Include="BCrypt.Net-Next" />
      <PackageReference Include="Microsoft.EntityFrameworkCore" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
      <!-- Database provider package, selected by the DatabaseProvider template switch. Delete-style
           (real content) like the cloud package blocks: the template keeps only the chosen branch.
           Source references all three but compiles only the SqlServer DatabaseProviderSetup.cs, so
           exactly one provider is ever used at runtime. -->
      <!--#if (UsePostgreSql) -->
      <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
      <!--#elseif (UseOracle) -->
      <PackageReference Include="Oracle.EntityFrameworkCore" />
      <!--#else -->
      <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
      <!--#endif -->
      <PackageReference Include="Microsoft.EntityFrameworkCore.Tools">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
      <PackageReference Include="Microsoft.Extensions.Caching.Abstractions" />
      <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
      <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
      <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
      <PackageReference Include="Microsoft.IdentityModel.Logging" />
      <PackageReference Include="Microsoft.IdentityModel.Tokens" />
      <PackageReference Include="QRCoder" />
      <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
      <PackageReference Include="OpenTelemetry" />
      <PackageReference Include="Serilog" />
      <!-- Email subsystem packages (core - always included) -->
      <PackageReference Include="Fluid.Core" />
      <PackageReference Include="HtmlAgilityPack" />
    </ItemGroup>

    <!-- Email provider packages - included in source for compilation, conditional in output template -->
    <ItemGroup>
      <PackageReference Include="SendGrid" />
      <PackageReference Include="AWSSDK.SimpleEmailV2" />
      <PackageReference Include="Postmark" />
      <PackageReference Include="Mandrill.net" />
    </ItemGroup>

    <!--#if (UseSendGrid) -->
    <!--<ItemGroup>
      <PackageReference Include="SendGrid" />
    </ItemGroup>-->
    <!--#endif -->

    <!--#if (UseAwsSes) -->
    <!--<ItemGroup>
      <PackageReference Include="AWSSDK.SimpleEmailV2" />
    </ItemGroup>-->
    <!--#endif -->

    <!--#if (UsePostmark) -->
    <!--<ItemGroup>
      <PackageReference Include="Postmark" />
    </ItemGroup>-->
    <!--#endif -->

    <!--#if (UseMailchimp) -->
    <!--<ItemGroup>
      <PackageReference Include="Mandrill.net" />
    </ItemGroup>-->
    <!--#endif -->

    <!--#if (UseMailgun) -->
    <!-- Mailgun uses HttpClient directly, no additional package needed -->
    <!--#endif -->

    <ItemGroup>
      <EmbeddedResource Include="Security\BlacklistedPasswordSet.txt" />
      <EmbeddedResource Include="Emailing\Templates\**\*" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Persistence\Migrations\" />
    </ItemGroup>

</Project>